		{
			"name": "1. Admin Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData && jsonData.data && jsonData.data.jwtToken) {",
							"    pm.collectionVariables.set(\"admin_token\", jsonData.data.jwtToken);",
							"    console.log(\"Token automatically saved!\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
