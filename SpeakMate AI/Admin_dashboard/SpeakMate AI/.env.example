VITE_APP_NAME=SpeakMate AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# API Base URL
# For local development, use: http://localhost:9091/api
# For deployed backend, use: https://speakmateai-backend.onrender.com
VITE_API_BASE_URL=https://speakmateai-backend.onrender.com

# AI API Keys (Phase 4 - AI Integration)
VITE_OPENAI_API_KEY=your_openai_key_here
VITE_GEMINI_API_KEY=your_gemini_key_here

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_VOICE_FEATURES=true
VITE_ENABLE_PREMIUM=false

# NOTE: In development, the Vite proxy forwards /api to the backend.
# The backend default port is 9091. If your backend runs on a different
# port, update the proxy target in vite.config.js accordingly.
