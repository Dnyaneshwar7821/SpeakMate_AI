# SpeakMate AI Mobile App Configuration
# Expo SDK automatic client environment variables (prefixed with EXPO_PUBLIC_)

# Deployed Backend API URL
EXPO_PUBLIC_API_URL=https://speakmate-ai-28z5.onrender.com

# App Info & Environment
EXPO_PUBLIC_APP_NAME=SpeakMateAI
EXPO_PUBLIC_APP_ENV=production

# Feature Toggles
EXPO_PUBLIC_ENABLE_LIVE2D=true
EXPO_PUBLIC_ENABLE_AUDIO_FEEDBACK=true

# Optional custom Live2D web avatar URL (defaults to standalone embed if empty)
# EXPO_PUBLIC_WEB_AVATAR_URL=https://cdn.jsdelivr.net/gh/Dnyaneshwar7821/speakmate-ai-web-frontend@main/public
